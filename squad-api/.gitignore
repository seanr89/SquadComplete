## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Windows image recurse caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recruit unit test result files
*.utp

# Executable files
*.exe
*.pdb
*.dll

# Command-line log files
BenchmarkDotNet.Artifacts/

# DotSettings temp files
*.dotSettings.user

# ReSharper is a .NET coding assistance extension by JetBrains
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield output folder
[Ee]xpress/

# DocProject is a documentation generator add-in
DocProject/buildhelp/
DocProject/Help/*.mcgh

# Backup and project builds generated by Visual Studio
_Changelist*
TestResult/
*.[Bb]ak
*.[Ll]og
*.[Ss]uo
*.[Uu]ser
*.[Uu]serOSSCache
*.[Ss]ln.docstates

# Files for Microsoft Azure AzureStorageEmulator
devstoreaccount1.db
devstoreaccount1.db.getlock

# OpenCover VS Extension output
OpenCover/

# Azure Cloud Service build commands output
proxytunnel.log
ServiceDefinition.csdef
ServiceConfiguration.Local.cscfg
ServiceConfiguration.Cloud.cscfg

# nunit load-config
TestResult.xml
nunit-agent.log
nunit-server-8000.log
VisualStudioTestExplorerExtensions/

# EvoSuite
.evosuite/

# Rider
.idea/
*.sln.iml

# JustMock
*.JustMock

# SonarLint for Visual Studio
.sonarlint/

# Mac files
.DS_Store

# User-specific files (WebStorm)
.idea/
.idea/libraries/
.idea/runConfigurations/
.idea/vcs.xml
.idea/modules.xml
.idea/workspace.xml
.idea/deployment.xml
.idea/tasks.xml
.idea/dictionaries/
.idea/shelf/
.idea/scopes/
.idea/jsLibraryMappings.xml
.idea/copyright/
.idea/encodings.xml
.idea/inspectionProfiles/
.idea/inspectionProfiles/Project_Default.xml
.idea/misc.xml
.idea/remote-mappings.xml
.idea/dataSources.xml
.idea/dataSources.local.xml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
/wwwroot/lib/

# StyleCop
StyleCop.Cache

# JetBrains Rider
.idea/

# Client-sideHub
.cache/

# Entity Framework Core migrations
# Uncomment this if you want to keep migrations in your source control
# *.Designer.cs

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet Config to restore to a custom location
# [Nn]u[Gg]et.config
# [Nn]u[Gg]et.exe

# BROWSER_LINK
_vti_pvt/
_vti_cnf/
_vti_log/
_vti_bin/
_vti_txt/

# Others
/obj/
/bin/
[Pp]ublish/

# Secrets
appsettings.json
!appsettings.json
# Often appsettings.json is checked in but appsettings.Development.json is not, or vice versa.
# I will keep appsettings.json but maybe user wants to ignore secrets.
# Usually DefaultConnection is in appsettings.json.
# I'll leave the appsettings.json entry commented out if I'm not sure.
# Actually I'll just add standard ones.
[Aa]pp[Ss]ettings.[Dd]evelopment.json
