### Player Fixture Statistics

# @name GetAllPlayerFixtureStatistics
GET {{squad_api_HostAddress}}/api/player-fixture-statistics
Accept: application/json

###

# @name GetPlayerFixtureStatisticById
GET {{squad_api_HostAddress}}/api/player-fixture-statistics/1/1
Accept: application/json

###

# @name CreatePlayerFixtureStatistic
POST {{squad_api_HostAddress}}/api/player-fixture-statistics
Content-Type: application/json

{
  "fixtureId": 1,
  "playerId": 1,
  "teamId": 10,
  "minutes": 90,
  "number": 7,
  "position": "RW",
  "rating": 8.5,
  "isCaptain": false,
  "isSubstitute": false
}

###

# @name UpdatePlayerFixtureStatistic
PUT {{squad_api_HostAddress}}/api/player-fixture-statistics/1/1
Content-Type: application/json

{
  "teamId": 10,
  "minutes": 95,
  "number": 7,
  "position": "RW",
  "rating": 9.0,
  "isCaptain": true,
  "isSubstitute": false
}

###

# @name DeletePlayerFixtureStatistic
DELETE {{squad_api_HostAddress}}/api/player-fixture-statistics/1/1

###

