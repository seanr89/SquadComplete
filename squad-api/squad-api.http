@squad_api_HostAddress = http://localhost:5212

### User Squads

# @name SubmitUserSquad
POST {{squad_api_HostAddress}}/api/user-squads
Content-Type: application/json

{
  "browserIdentifierId": "test-browser-id-12345",
  "userName": "Player One",
  "gameRecordId": 1,
  "formationId": 1,
  "players": [
    { "playerId": 1, "position": "GK", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 2, "position": "DEF", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 3, "position": "DEF", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 4, "position": "DEF", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 5, "position": "DEF", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 6, "position": "MID", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 7, "position": "MID", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 8, "position": "MID", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 9, "position": "FWD", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 10, "position": "FWD", "isCaptain": false, "isViceCaptain": false },
    { "playerId": 11, "position": "FWD", "isCaptain": true, "isViceCaptain": false }
  ]
}

###

# @name GetLeaderboard
GET {{squad_api_HostAddress}}/api/user-squads/1/leaderboard
Accept: application/json

###

### Feedback

# @name SubmitFeedback
POST {{squad_api_HostAddress}}/api/feedback
Content-Type: application/json

{
  "name": "Jane Doe",
  "email": "jane@example.com",
  "message": "Great draft challenge today!"
}

